# Copy to .env on the VPS and fill in. Read by docker-compose (env_file) —
# .env is gitignored, so real values never enter the repo.

# --- Supabase Postgres ---
# Supabase → Project Settings → Database → Connection string → URI.
# Use the DIRECT connection (port 5432), not the pooled one (6543): Prisma
# migrate deploy cannot run through pgbouncer.
#
# One URL per service, and they are not interchangeable:
#   - Prisma understands ?schema=...; keep the two services in separate
#     schemas so they do not share tables by accident.
#   - psycopg passes the URI straight to libpq, which rejects ?schema= as an
#     unknown parameter. Leave the claims URL free of query parameters.
DISPATCH_DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?schema=dispatch
CLAIMS_DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Supabase Auth ---
# Project URL only. claims-privacy verifies bearer tokens against this
# project's JWKS endpoint, so no secret belongs here. Without it the
# service refuses requests rather than serving them unauthenticated.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase → Project Settings → API → anon/public key. Public by design (the
# mobile app ships it); dispatch uses it only to read the caller's own profile
# row through RLS when checking provider ownership. Without it the provider
# endpoints refuse requests.
SUPABASE_ANON_KEY=

# --- Dispatch: Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Dispatch: tuning (defaults in components/dispatch/src/config/index.ts) ---
LOG_LEVEL=info

# --- Claims-privacy: Cloudflare R2 (S3-compatible) ---
# Cloudflare dashboard → R2 → bucket → Manage R2 API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=
MIN_CAPTURE_PHOTOS=6

# --- Public hostnames ---
# Caddy serves <service>.$BASE_DOMAIN and gets Let's Encrypt certificates for
# each. Leave unset once kaduna.lk's A records point at the server; until then
# set the dashed-IP sslip.io form, e.g.
# BASE_DOMAIN=169-58-147-190.sslip.io

EXPO_PUBLIC_SUPABASE_URL=https://huynmjagdlkvqcmgdipk.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_afsnNQOy9fRKfu-5i1lWUw_AQ9vBRJO
EXPO_PUBLIC_API_URL=
