# Reference proposal PDFs and team-provided datasets — do NOT commit
docs/*.pdf
docs/*.txt
docs/NEV_fault_dataset.csv
docs/synthetic_telemetry_data.csv

# Team-provided reference CSVs kept local (not for publication)
components/dispatch/ml/new_datasets/NEV_fault_dataset.csv
components/dispatch/ml/new_datasets/synthetic_telemetry_data.csv

# tsc output for the shared contract sources (the .ts files are the artefact)
contracts/*.js
contracts/*.js.map
contracts/*.d.ts
contracts/*.d.ts.map

# Derived: rebuilt from knowledge/*.md whenever the corpus changes.
components/predictive-maintenance/knowledge/.embeddings.json

# Structurizr Lite runtime output (only workspace.dsl and docs/ are tracked)
docs/architecture/workspace.json
docs/architecture/.structurizr/
