# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined into the

# browser bundle — use the Supabase anon/publishable key only (never service role).



# --- Supabase (required for sign-in) ---

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx



# --- Backend services ---

# Local: http://localhost:5001 / http://localhost:3001 / http://localhost:5000

NEXT_PUBLIC_GEO_URL=http://localhost:5001

NEXT_PUBLIC_DISPATCH_URL=http://localhost:3001

NEXT_PUBLIC_MAINTENANCE_URL=http://localhost:5000


# --- Google Maps (preferred basemap) ---
# Maps JavaScript API key. When set, the ops map and the /report location
# picker render on Google; when unset both fall back to Leaflet/CARTO tiles.
# This value is inlined into the public bundle — restrict the key by HTTP
# referrer (kaduna.lk, www.kaduna.lk, localhost) in the Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
