# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined into the
# browser bundle, so only client-safe credentials belong here.

# --- Supabase (dashboard sign-in; tokens are sent to the backend services) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- Backend services ---
# Local: http://localhost:5001 / http://localhost:3001
NEXT_PUBLIC_GEO_URL=https://geo.kaduna.lk
NEXT_PUBLIC_DISPATCH_URL=https://dispatch.kaduna.lk
