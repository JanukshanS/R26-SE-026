# Copy this file to apps/mobile/.env and fill in real values, then restart Expo
# with `npx expo start -c` (Metro caches inlined EXPO_PUBLIC_* values).
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time — only
# put client-safe credentials here. Cloud (EAS) builds do NOT read this file;
# register the same variables with `eas env:create` per profile.

# --- Supabase (auth + Postgres + storage) ---
# Project settings → API. Use the publishable key, never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- Backend services ---
# Local: use this machine's LAN IP so a physical device can reach it, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# Deployed: the live hostnames in docs/deployment.md. These are inlined into
# the bundle at build time, so a release APK talks to whatever was set when it
# was built — set them before `./gradlew assembleRelease`, not after.
#
# NOTE for EAS builds: this file is gitignored, and EAS uploads only tracked
# files, so NOTHING here reaches an EAS build. Production values live as EAS
# environment variables on the project instead (`eas env:list --environment
# production`). Keep the two in step; a value that exists only here is missing
# from every release build.
EXPO_PUBLIC_DISPATCH_URL=https://dispatch.vps.kaduna.lk
EXPO_PUBLIC_MAINTENANCE_URL=https://predict.vps.kaduna.lk

# --- Google Maps (Android) ---
# Maps SDK for Android key, injected into the manifest by app.config.js.
# Without it react-native-maps renders a blank grey map in a dev/release build
# (Expo Go carries its own key, so the map works there regardless).
# Restrict this key by package name com.kaduna.app + signing SHA-1 — a
# referrer-restricted web key will NOT work here, it has to be a second key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
