# Claims-privacy backend (FastAPI) — use your Mac’s LAN IP so a physical device on
# the same Wi-Fi can reach it.
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# Run backend: cd components/claims-privacy && bash run-dev.sh
# Copy this file to .env in apps/mobile/, then restart Expo (npx expo start -c).
EXPO_PUBLIC_API_URL=
