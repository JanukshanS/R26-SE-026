# Copy this file to apps/mobile/.env and fill in real values, then restart Expo
# with `npx expo start -c` (Metro caches inlined EXPO_PUBLIC_* values).
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time — only
# put client-safe credentials here. Cloud (EAS) builds do NOT read this file;
# register the same variables with `eas env:create` per profile.

# --- Supabase (auth + Postgres + storage) ---
# Project settings → API. Use the publishable key, never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- Claims-privacy backend (FastAPI) ---
# Local device on the same Wi-Fi: http://<your-LAN-IP>:8000
# Deployed:                       https://claims.kaduna.lk
EXPO_PUBLIC_API_URL=https://claims.kaduna.lk
