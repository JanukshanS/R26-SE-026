# Copy this file to apps/mobile/.env and fill in real values, then restart Expo
# with `npx expo start -c` (Metro caches inlined EXPO_PUBLIC_* values).
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time — only
# put client-safe credentials here. Cloud (EAS) builds do NOT read this file;
# register the same variables with `eas env:create` per profile.

# --- Supabase (auth + Postgres + storage) ---
# Project settings → API. Use the publishable key, never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# --- Backend services ---
# Local: use this machine's LAN IP so a physical device can reach it, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# Deployed: the live hostnames in docs/deployment.md. These are inlined into
# the bundle at build time, so a release APK talks to whatever was set when it
# was built — set them before `./gradlew assembleRelease`, not after.
EXPO_PUBLIC_API_URL=https://claims.169-58-147-190.sslip.io
EXPO_PUBLIC_DISPATCH_URL=https://dispatch.169-58-147-190.sslip.io
EXPO_PUBLIC_MAINTENANCE_URL=https://predict.169-58-147-190.sslip.io

# --- Google Maps (Android) ---
# Read only by app.config.ts at prebuild/build time — populates
# AndroidManifest.xml, never bundled into client JS. Restrict this key in
# Google Cloud Console to package com.kaduna.app + your signing cert's SHA-1.
# For EAS cloud builds, register the same value with `eas env:create` per
# profile — this file isn't read there.
GOOGLE_MAPS_API_KEY=your-google-maps-android-key
