# Copy to .env and fill in your own values. Never commit .env.

# PostgreSQL: unused — captures/capture_photos moved to Supabase Postgres.
# Leave DATABASE_URL unset unless reviving this service.

# Supabase Auth (bearer-token verification) — project URL only, keys come from its JWKS endpoint.
SUPABASE_URL=https://your-project.supabase.co

# Cloudflare R2 (S3-compatible) — from Cloudflare dashboard: R2 -> bucket -> Manage R2 API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
