# --- PostgreSQL ---
# Example (local): postgresql://app:app@localhost:5432/guided_camera
# Example (managed): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=

# --- Cloudflare R2 (S3-compatible) ---
# From Cloudflare dashboard: R2 → bucket → S3 API endpoint
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=

# Optional: public custom domain for direct reads (e.g. https://assets.example.com)
R2_PUBLIC_BASE_URL=

# Minimum photos required before /captures/{id}/complete succeeds
MIN_CAPTURE_PHOTOS=6
