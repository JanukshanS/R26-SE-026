# Copy this file to .env and fill in your own values.
# Never commit .env — it contains live credentials.

# --- PostgreSQL ---
# Example (local): postgresql://app:app@localhost:5432/guided_camera
# Example (managed): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Cloudflare R2 (S3-compatible) ---
# From Cloudflare dashboard: R2 → bucket → Manage R2 API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Optional: public custom domain for direct reads (e.g. https://assets.example.com)
R2_PUBLIC_BASE_URL=

# Minimum photos required before /captures/{id}/complete succeeds
MIN_CAPTURE_PHOTOS=6
