# Local development. In docker-compose these come from the root .env instead.

# Supabase direct connection (port 5432, not the 6543 pooler: migrate deploy
# cannot run through pgbouncer). Own schema, so these tables never mix with
# dispatch's or the app's.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?schema=garage

# Bearer tokens are verified against this project's JWKS; the anon key is used
# to read the caller's profiles.provider_id with their own token. Without
# these the service answers 503 rather than serving unauthenticated.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Used by POST /api/v1/job-cards/from-dispatch.
DISPATCH_URL=http://localhost:3001
# Shared secret for /internal, which the parts service calls. Same value in
# components/parts-management. Empty turns /internal off.
INTERNAL_API_TOKEN=

PORT=3002
LOG_LEVEL=info

# Minutes east of UTC for "due today" on the dashboard (Sri Lanka = 330).
GARAGE_TZ_OFFSET_MINUTES=330

# Local only, never in production: skip sign-in and act as this user/provider.
# DEV_AUTH_BYPASS_USER_ID=
# DEV_AUTH_BYPASS_PROVIDER_ID=
