# Postgres for this service; ?schema=parts keeps it apart from the others.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/garage_dev?schema=parts
# Supabase project: verifies bearer tokens and reads a caller's own vehicles.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The garage service, and the shared secret for its /internal API (same value there).
GARAGE_URL=http://localhost:3002
INTERNAL_API_TOKEN=
PORT=3003
LOG_LEVEL=info
