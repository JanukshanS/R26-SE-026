# Copy to .env and fill in. Used when running uvicorn locally:
#   uvicorn app.main:app --reload --port 5000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Optional — omit to use SQLite (predictive.db in this folder)
# PREDICTIVE_DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres
# PREDICTIVE_DB_SCHEMA=predictive

# Optional. Enables the language model that rewords maintenance advice into
# friendlier prose. WITHOUT IT NOTHING BREAKS - the advice endpoint returns the
# deterministic wording instead, which is what would have been shown anyway.
#
# SERVER-SIDE ONLY. Never expose this as an EXPO_PUBLIC_* or NEXT_PUBLIC_*
# variable: those are compiled into the shipped client bundles and are readable
# by anyone who unpacks the app.
OPENAI_API_KEY=
# Defaults to gpt-4o-mini, which is plenty for rewording a fixed diagnosis.
OPENAI_MODEL=
