# Reverse proxy + automatic TLS for the Kaduna.lk backend.
#
# One subdomain per service rather than path prefixes on a single host: no
# prefix stripping, so each service's own routes (/api/v1/..., /v1/..., /docs)
# and its OpenAPI spec stay correct with no root_path configuration.
#
# DNS: point A records for dispatch, geo, predict and claims at the VPS IP.
# Caddy provisions Let's Encrypt certificates on first request per hostname.

{
	email admin@kaduna.lk
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

dispatch.kaduna.lk {
	import common
	reverse_proxy dispatch:3001
}

geo.kaduna.lk {
	import common
	reverse_proxy geo-intelligence:5001
}

predict.kaduna.lk {
	import common
	reverse_proxy predictive-maintenance:5000
}

claims.kaduna.lk {
	import common
	reverse_proxy claims-privacy:8000
}
